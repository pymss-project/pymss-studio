{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@tauri-apps/api/core": [
        "src/sdk.ts"
      ],
      "@tauri-apps/api/event": [
        "src/sdk.ts"
      ],
      "@tauri-apps/plugin-shell": [
        "src/sdk.ts"
      ],
      "vue": [
        "../node_modules/vue"
      ],
      "vue-i18n": [
        "../node_modules/vue-i18n"
      ],
      "naive-ui": [
        "../node_modules/naive-ui"
      ],
      "@vicons/ionicons5": [
        "../node_modules/@vicons/ionicons5"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "../../plugins/*/ui/src/**/*.vue"
  ]
}
